# URL base do backend (sem o sufixo /api). O código adiciona /api e /ws.
#
# Dev local (frontend em :3000, backend em :8000 são origens diferentes):
#   PUBLIC_API_URL=http://localhost:8000
#   PUBLIC_WS_URL=ws://localhost:8000
#
# Produção atrás do Nginx Proxy Manager (mesma origem, NPM faz proxy):
#   Deixe vazio (ou não defina). O cliente usa caminhos relativos:
#     - /api/...
#     - /ws/...
#     - /media/..., /static/...
PUBLIC_API_URL=http://localhost:8000
PUBLIC_WS_URL=ws://localhost:8000

# URL do novo Portal (corbot-portal), usada para redirecionar (hard navigation)
# usuários corban/gerente/líder/vendedor que fizerem login por aqui.
# Deixe vazio para desativar o redirect (ex.: só admin usa este app).
PUBLIC_PORTAL_APP_URL=http://localhost:3001
