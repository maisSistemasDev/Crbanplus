---
import BaseLayout from './BaseLayout.astro';
import { TourListener } from '../components/react/tour/TourListener';
import { ChatWidget } from '../components/react/ai/ChatWidget';
interface Props {
  title?: string;
}
const { title = 'CorbanPlus' } = Astro.props;
---
<BaseLayout title={title}>
  <slot />
  <!-- Listener invisível: executa tours disparados pelo agente via pendingTour store -->
  <TourListener client:only="react" />
  <!-- Assistente IA flutuante -->
  <ChatWidget client:only="react" />
</BaseLayout>
