---
import BaseLayout from '../../layouts/BaseLayout.astro';

type Row = [string, string, string, string];

interface Section { id: string; title: string; rows: Row[]; }

const sections: Section[] = [
  { id: 'ep-auth', title: 'Autenticação JWT', rows: [
    ['POST', '/api/token/', 'Login — retorna access + refresh token', 'Público'],
    ['POST', '/api/token/refresh/', 'Renova o access token', 'Público'],
  ]},
  { id: 'ep-users', title: 'Usuários', rows: [
    ['GET', '/api/users/me/', 'Usuário autenticado atual', 'Autenticado'],
    ['GET', '/api/users/', 'Listar usuários', 'Admin/Colaborador'],
    ['POST', '/api/users/', 'Criar usuário', 'Admin/Colaborador'],
    ['GET/PUT/DELETE', '/api/users/{id}/', 'Detalhe, atualizar ou remover usuário', 'Admin'],
    ['GET', '/api/users/sellers/', 'Listar vendedores', 'Admin/Empresa Admin'],
    ['GET', '/api/users/leaders/', 'Listar líderes', 'Admin/Empresa Admin'],
    ['POST', '/api/users/leaders/', 'Criar líder', 'Admin/Empresa Admin'],
    ['POST', '/api/users/managers/', 'Criar gerente', 'Admin'],
    ['POST', '/api/users/{id}/change_leader/', 'Alterar líder do vendedor', 'Admin/Empresa Admin'],
    ['POST', '/api/users/batch_change_leader/', 'Alteração em lote de líder', 'Admin'],
    ['POST', '/api/users/import/sellers/', 'Importar vendedores via CSV', 'Admin'],
    ['GET', '/api/users/import/sellers/template/', 'Download template CSV de vendedores', 'Admin'],
  ]},
  { id: 'ep-companies', title: 'Corbans (Empresas)', rows: [
    ['GET', '/api/companies/', 'Listar corbans', 'Admin/Colaborador'],
    ['POST', '/api/companies/', 'Criar corban', 'Admin'],
    ['GET/PUT/DELETE', '/api/companies/{uuid}/', 'Detalhe, atualizar ou remover corban', 'Admin'],
  ]},
  { id: 'ep-banks', title: 'Bancos', rows: [
    ['GET', '/api/banks/', 'Listar bancos', 'Autenticado'],
    ['POST', '/api/banks/', 'Criar banco', 'Admin'],
    ['GET/PUT/DELETE', '/api/banks/{uuid}/', 'Detalhe do banco', 'Admin'],
  ]},
  { id: 'ep-agreements', title: 'Convênios', rows: [
    ['GET', '/api/agreements/', 'Listar convênios', 'Autenticado'],
    ['POST', '/api/agreements/', 'Criar convênio', 'Admin'],
    ['GET/PUT/DELETE', '/api/agreements/{uuid}/', 'Detalhe do convênio', 'Admin'],
  ]},
  { id: 'ep-tables', title: 'Tabelas de Comissão', rows: [
    ['GET', '/api/tables/', 'Listar tabelas', 'Autenticado'],
    ['POST', '/api/tables/', 'Criar tabela', 'Admin'],
    ['GET/PUT/DELETE', '/api/tables/{uuid}/', 'Detalhe da tabela', 'Admin'],
    ['DELETE', '/api/tables/bulk-delete/', 'Remover tabelas em lote', 'Admin'],
    ['POST', '/api/tables/create-batch/', 'Importar tabelas via CSV', 'Admin'],
    ['GET', '/api/tables/download-example/', 'Template CSV de tabelas', 'Admin'],
    ['GET', '/api/tables/export-csv/', 'Exportar todas as tabelas (CSV)', 'Admin'],
    ['GET', '/api/tables/export-csv/{bank_uuid}/', 'Exportar tabelas por banco (CSV)', 'Admin'],
    ['GET', '/api/tables/by-bank/{bank_uuid}/', 'Listar tabelas por banco', 'Autenticado'],
    ['GET', '/api/tables/{uuid}/history/', 'Histórico de alterações da tabela', 'Admin'],
  ]},
  { id: 'ep-bank-access', title: 'Acessos Bancários', rows: [
    ['GET', '/api/bank-accesses/', 'Listar acessos bancários', 'Admin'],
    ['POST', '/api/bank-accesses/', 'Criar acesso bancário', 'Admin'],
    ['GET/PUT/DELETE', '/api/bank-accesses/{uuid}/', 'Detalhe do acesso', 'Admin'],
    ['GET', '/api/access-logs/', 'Logs de acesso bancário', 'Admin'],
  ]},
  { id: 'ep-proposals', title: 'Propostas', rows: [
    ['GET', '/api/proposals/', 'Listar propostas', 'Autenticado'],
    ['POST', '/api/proposals/preview-rows/', 'Pré-visualizar CSV antes do upload', 'Admin'],
    ['GET', '/api/proposals/layouts/', 'Listar layouts de importação', 'Admin'],
    ['POST', '/api/proposals/layouts/', 'Criar layout de importação', 'Admin'],
    ['GET/PUT/DELETE', '/api/proposals/layouts/{uuid}/', 'Detalhe do layout', 'Admin'],
    ['GET', '/api/proposals/fields/', 'Campos mapeáveis nos layouts', 'Admin'],
    ['GET', '/api/proposals/batch/', 'Listar lotes de propostas', 'Admin'],
    ['POST', '/api/proposals/batch/', 'Criar novo lote (upload CSV + layout)', 'Admin'],
    ['GET/PUT', '/api/proposals/batch/{uuid}/', 'Detalhe/status do lote', 'Admin'],
    ['GET', '/api/proposals/batch/{uuid}/proposals/', 'Propostas de um lote', 'Admin'],
    ['GET', '/api/proposals/status-payment/', 'Mapeamentos de status de pagamento por banco', 'Admin'],
  ]},
  { id: 'ep-commissions', title: 'Comissões', rows: [
    ['GET', '/api/commissions/', 'Listar comissões', 'Autenticado'],
    ['GET', '/api/commissions/{id}/', 'Detalhe de comissão', 'Autenticado'],
    ['GET', '/api/commissions/mirror/', 'Espelho — visão consolidada do vendedor', 'Vendedor/Líder'],
    ['GET', '/api/commissions/balance/', 'Saldo disponível do usuário', 'Autenticado'],
    ['POST', '/api/commissions/release/', 'Liberar comissões para pagamento', 'Admin'],
    ['GET', '/api/commissions/export/', 'Exportar comissões (CSV)', 'Admin'],
    ['POST', '/api/commissions/update-status/', 'Atualizar status em lote', 'Admin'],
  ]},
  { id: 'ep-commission-groups', title: 'Grupos de Comissão', rows: [
    ['GET', '/api/commission-groups/', 'Listar grupos de comissão', 'Admin/Empresa Admin'],
    ['POST', '/api/commission-groups/', 'Criar grupo de comissão', 'Admin'],
    ['GET/PUT/DELETE', '/api/commission-groups/{id}/', 'Detalhe do grupo', 'Admin'],
    ['GET/POST', '/api/commission-groups/{id}/members/', 'Membros do grupo', 'Admin'],
    ['POST', '/api/commission-groups/{id}/import-csv/', 'Importar membros via CSV', 'Admin'],
    ['GET', '/api/commission-groups/max-rates/', 'Taxas máximas configuradas', 'Admin'],
    ['GET', '/api/commission-groups/by-company/', 'Grupos da promotora por empresa', 'Admin'],
    ['POST', '/api/commission-groups/by-company/', 'Criar grupo da promotora', 'Admin'],
    ['GET/PUT/DELETE', '/api/commission-groups/by-company/{id}/', 'Detalhe do grupo da promotora', 'Admin'],
  ]},
  { id: 'ep-payments', title: 'Pagamentos & Saques', rows: [
    ['GET', '/api/payments/', 'Listar pagamentos', 'Admin'],
    ['POST', '/api/payments/generate-comissions/', 'Gerar comissões a partir das propostas', 'Admin'],
    ['GET', '/api/withdrawals/', 'Listar saques solicitados', 'Autenticado'],
    ['POST', '/api/withdrawals/corbanpay/', 'Solicitar saque via CorbanPay', 'Autenticado'],
  ]},
  { id: 'ep-internal-users', title: 'Usuários Internos (Promotora)', rows: [
    ['GET', '/api/internal-users/', 'Listar colaboradores da promotora', 'Admin'],
    ['POST', '/api/internal-users/', 'Criar colaborador da promotora', 'Admin'],
    ['GET/PUT/DELETE', '/api/internal-users/{id}/', 'Detalhe do colaborador', 'Admin'],
    ['GET/POST', '/api/internal-users/{id}/permissions/', 'Permissões do colaborador', 'Admin'],
    ['GET', '/api/internal-users/available-permissions/', 'Lista de permissões disponíveis', 'Admin'],
    ['GET', '/api/permission-templates/', 'Listar templates de permissão', 'Admin'],
    ['POST', '/api/permission-templates/', 'Criar template de permissão', 'Admin'],
    ['POST', '/api/permission-templates/{id}/apply-to-user/', 'Aplicar template a colaborador', 'Admin'],
  ]},
  { id: 'ep-api-keys', title: 'Chaves de API', rows: [
    ['GET', '/api/api-keys/', 'Listar chaves de API', 'Admin Promotora'],
    ['POST', '/api/api-keys/', 'Criar chave (full_key exibida uma vez)', 'Admin Promotora'],
    ['GET', '/api/api-keys/{uuid}/', 'Detalhe da chave', 'Admin Promotora'],
    ['PATCH', '/api/api-keys/{uuid}/', 'Atualizar nome/escopos/validade', 'Admin Promotora'],
    ['DELETE', '/api/api-keys/{uuid}/', 'Remover chave permanentemente', 'Admin Promotora'],
    ['POST', '/api/api-keys/{uuid}/revoke/', 'Revogar (desativar) chave', 'Admin Promotora'],
    ['GET', '/api/api-keys/available-scopes/', 'Listar escopos disponíveis', 'Admin Promotora'],
  ]},
];

const methodColor: Record<string, string> = {
  GET: 'bg-blue-900 text-blue-300',
  POST: 'bg-green-900 text-green-300',
  PUT: 'bg-yellow-900 text-yellow-300',
  PATCH: 'bg-orange-900 text-orange-300',
  DELETE: 'bg-red-900 text-red-300',
};

function getMethodClass(method: string): string {
  const base = method.split('/')[0];
  return methodColor[base] ?? 'bg-gray-700 text-gray-300';
}
---

<BaseLayout title="Documentação da API - CorbanPlus">
  <div class="min-h-screen bg-gray-950 text-gray-200" style="font-family: Inter, sans-serif;">

    <header class="sticky top-0 z-40 bg-gray-900 border-b border-gray-800 px-6 py-3 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <span class="text-xl font-bold text-white">CorbanPlus</span>
        <span class="text-xs bg-blue-600 text-white px-2 py-0.5 rounded-full font-medium">API v1</span>
      </div>
      <a href="/developer" class="text-sm text-blue-400 hover:text-blue-300">&#8592; Área do Desenvolvedor</a>
    </header>

    <div class="flex">
      <nav class="hidden lg:block w-64 shrink-0 sticky top-[53px] h-[calc(100vh-53px)] overflow-y-auto border-r border-gray-800 bg-gray-900 p-5">
        <ul class="space-y-0.5 text-sm">
          <li class="text-xs font-semibold text-gray-500 uppercase tracking-wider py-2">Introdução</li>
          <li><a href="#visao-geral" class="doc-link">Visão Geral</a></li>
          <li><a href="#autenticacao" class="doc-link">Autenticação</a></li>
          <li><a href="#erros" class="doc-link">Erros &amp; Respostas</a></li>
          <li><a href="#paginacao" class="doc-link">Paginação</a></li>
          <li class="text-xs font-semibold text-gray-500 uppercase tracking-wider py-2 mt-4">Fluxos</li>
          <li><a href="#fluxo-usuarios" class="doc-link">Criação de Usuários</a></li>
          <li><a href="#fluxo-propostas" class="doc-link">Propostas</a></li>
          <li><a href="#fluxo-comissoes" class="doc-link">Comissões &amp; Pagamentos</a></li>
          <li class="text-xs font-semibold text-gray-500 uppercase tracking-wider py-2 mt-4">Endpoints</li>
          {sections.map(s => (
            <li><a href={`#${s.id}`} class="doc-link">{s.title}</a></li>
          ))}
          <li class="text-xs font-semibold text-gray-500 uppercase tracking-wider py-2 mt-4">Payloads</li>
          <li><a href="#payload-auth" class="doc-link">Autenticação</a></li>
          <li><a href="#payload-users" class="doc-link">Usuários</a></li>
          <li><a href="#payload-companies" class="doc-link">Corbans</a></li>
          <li><a href="#payload-tables" class="doc-link">Tabelas</a></li>
          <li><a href="#payload-proposals" class="doc-link">Propostas</a></li>
          <li><a href="#payload-commissions" class="doc-link">Comissões</a></li>
          <li><a href="#payload-groups" class="doc-link">Grupos de Comissão</a></li>
          <li><a href="#payload-payments" class="doc-link">Pagamentos</a></li>
          <li><a href="#payload-apikeys" class="doc-link">Chaves de API</a></li>
          <li class="text-xs font-semibold text-gray-500 uppercase tracking-wider py-2 mt-4">Referência</li>
          <li><a href="#roles" class="doc-link">Papéis &amp; Permissões</a></li>
          <li><a href="#scopes" class="doc-link">Escopos API Key</a></li>
        </ul>
      </nav>

      <main class="flex-1 max-w-4xl px-6 lg:px-10 py-10 space-y-16">

        <section id="visao-geral">
          <h1 class="text-3xl font-bold text-white mb-3">Documentação da API</h1>
          <p class="text-gray-400 leading-relaxed">
            A API do <strong class="text-white">CorbanPlus</strong> é uma REST API para integração com a plataforma de gestão
            de comissões e propostas. Todos os endpoints retornam JSON e exigem autenticação.
          </p>
          <div class="mt-5 grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="bg-gray-800 rounded-xl p-4 border border-gray-700">
              <p class="text-xs text-gray-500 mb-1">Base URL</p>
              <code class="text-green-400 text-sm">https://api.seudominio.com.br/api</code>
            </div>
            <div class="bg-gray-800 rounded-xl p-4 border border-gray-700">
              <p class="text-xs text-gray-500 mb-1">Formato</p>
              <code class="text-green-400 text-sm">Content-Type: application/json</code>
            </div>
          </div>
        </section>

        <section id="autenticacao">
          <h2 class="section-title">Autenticação</h2>
          <div class="space-y-5">
            <div class="endpoint-card">
              <h3 class="text-white font-semibold mb-2">1. JWT &mdash; Login com CPF e Senha</h3>
              <p class="text-gray-400 text-sm mb-3">O identificador é o <strong class="text-white">CPF</strong>. Access token expira em <strong class="text-white">30 minutos</strong>; refresh em <strong class="text-white">1 dia</strong>.</p>
              <div class="code-block">
                <p><span class="text-cyan-400">POST</span> <span class="text-white">/api/token/</span></p>
                <pre class="text-green-400 text-xs mt-2 whitespace-pre">&#123;
  "cpf": "12345678901",
  "password": "minha_senha"
&#125;</pre>
                <p class="text-gray-500 text-xs mt-3">Use o access token em todas as requisições:</p>
                <p class="mt-1"><span class="text-yellow-400">Authorization</span>: <span class="text-green-400">Bearer &lt;access_token&gt;</span></p>
              </div>
            </div>
            <div class="endpoint-card">
              <h3 class="text-white font-semibold mb-2">2. Api-Key &mdash; Integração Server-to-Server</h3>
              <p class="text-gray-400 text-sm mb-3">Crie uma chave na <a href="/developer" class="text-blue-400 hover:underline">Área do Desenvolvedor</a>. O valor completo é exibido <strong class="text-white">uma única vez</strong>.</p>
              <div class="code-block">
                <p><span class="text-yellow-400">Authorization</span>: <span class="text-green-400">Api-Key crb_sua_chave_completa</span></p>
              </div>
              <div class="mt-3 bg-amber-900/30 border border-amber-700 rounded-lg p-3 text-sm text-amber-300">
                &#9888;&#65039; Cada chave possui <strong>escopos</strong>. Requests fora do escopo retornam <code class="text-red-400">403</code>.
              </div>
            </div>
          </div>
        </section>

        <section id="erros">
          <h2 class="section-title">Erros &amp; Respostas</h2>
          <table class="w-full text-sm border-collapse">
            <thead><tr class="border-b border-gray-700">
              <th class="text-left py-2 pr-4 text-gray-400 font-medium">Código</th>
              <th class="text-left py-2 pr-4 text-gray-400 font-medium">Significado</th>
              <th class="text-left py-2 text-gray-400 font-medium">Campo de erro</th>
            </tr></thead>
            <tbody class="divide-y divide-gray-800">
              <tr><td class="py-2 pr-4"><code class="text-green-400">200/201</code></td><td class="py-2 pr-4 text-gray-300">Sucesso</td><td class="py-2 text-gray-500">&mdash;</td></tr>
              <tr><td class="py-2 pr-4"><code class="text-orange-400">400</code></td><td class="py-2 pr-4 text-gray-300">Dados inválidos</td><td class="py-2"><code class="text-gray-400 text-xs">&#123;"campo": ["mensagem"]&#125;</code></td></tr>
              <tr><td class="py-2 pr-4"><code class="text-orange-400">401</code></td><td class="py-2 pr-4 text-gray-300">Não autenticado</td><td class="py-2"><code class="text-gray-400 text-xs">&#123;"detail": "..."&#125;</code></td></tr>
              <tr><td class="py-2 pr-4"><code class="text-orange-400">403</code></td><td class="py-2 pr-4 text-gray-300">Sem permissão</td><td class="py-2"><code class="text-gray-400 text-xs">&#123;"detail": "..."&#125;</code></td></tr>
              <tr><td class="py-2 pr-4"><code class="text-orange-400">404</code></td><td class="py-2 pr-4 text-gray-300">Não encontrado</td><td class="py-2"><code class="text-gray-400 text-xs">&#123;"detail": "Not found."&#125;</code></td></tr>
              <tr><td class="py-2 pr-4"><code class="text-red-400">500</code></td><td class="py-2 pr-4 text-gray-300">Erro interno</td><td class="py-2"><code class="text-gray-400 text-xs">&#123;"detail": "..."&#125;</code></td></tr>
            </tbody>
          </table>
        </section>

        <section id="paginacao">
          <h2 class="section-title">Paginação</h2>
          <p class="text-gray-400 mb-3">Listagens são paginadas (10 itens/página). Use <code class="text-green-400">?page=N</code>.</p>
          <div class="code-block">
            <pre class="text-green-400 text-xs whitespace-pre">&#123;
  "count": 42,
  "next": "/api/users/?page=3",
  "previous": "/api/users/?page=1",
  "results": [...]
&#125;</pre>
          </div>
        </section>

        <section id="fluxo-usuarios">
          <h2 class="section-title">Fluxo: Criação de Usuários</h2>
          <p class="text-gray-400 mb-4">O sistema tem dois universos: <strong class="text-white">Promotora</strong> (usuários internos) e <strong class="text-white">Corbans</strong> (empresas parceiras).</p>
          <div class="space-y-3">
            <div class="flow-step"><span class="step-badge">1</span><div>
              <p class="text-white font-medium">Criar o Corban</p>
              <code class="text-blue-400 text-xs">POST /api/companies/</code>
              <p class="text-gray-400 text-sm mt-0.5">Registre a empresa com CNPJ, cores de whitelabel e dados de contato.</p>
            </div></div>
            <div class="flow-step"><span class="step-badge">2</span><div>
              <p class="text-white font-medium">Criar o Administrador do Corban</p>
              <code class="text-blue-400 text-xs">POST /api/users/</code>
              <p class="text-gray-400 text-sm mt-0.5">Envie <code class="text-yellow-400">role: "empresa_admin"</code> e <code class="text-yellow-400">company: "uuid"</code>.</p>
            </div></div>
            <div class="flow-step"><span class="step-badge">3</span><div>
              <p class="text-white font-medium">Criar Gerentes e Líderes</p>
              <code class="text-blue-400 text-xs">POST /api/users/managers/ | POST /api/users/leaders/</code>
              <p class="text-gray-400 text-sm mt-0.5">Líderes recebem comissão de liderança sobre seus vendedores.</p>
            </div></div>
            <div class="flow-step"><span class="step-badge">4</span><div>
              <p class="text-white font-medium">Criar Vendedores (individual ou lote)</p>
              <code class="text-blue-400 text-xs">POST /api/users/ | POST /api/users/import/sellers/</code>
              <p class="text-gray-400 text-sm mt-0.5">Baixe o template: <code class="text-blue-400 text-xs">GET /api/users/import/sellers/template/</code></p>
            </div></div>
            <div class="flow-step"><span class="step-badge">5</span><div>
              <p class="text-white font-medium">Vincular vendedor a líder</p>
              <code class="text-blue-400 text-xs">POST /api/users/{"{id}"}/change_leader/</code>
            </div></div>
          </div>
          <div class="mt-5 bg-gray-800 rounded-xl p-4 border border-gray-700">
            <p class="text-xs text-gray-500 mb-3 font-semibold uppercase">Papéis disponíveis (campo <code>role</code>)</p>
            <div class="grid grid-cols-2 gap-2 text-xs">
              <div><code class="text-yellow-400">admin</code> <span class="text-gray-400">&mdash; Promotora, acesso total</span></div>
              <div><code class="text-yellow-400">colaborador</code> <span class="text-gray-400">&mdash; Promotora, permissões granulares</span></div>
              <div><code class="text-yellow-400">empresa_admin</code> <span class="text-gray-400">&mdash; Corban, administrador</span></div>
              <div><code class="text-yellow-400">gerente</code> <span class="text-gray-400">&mdash; Corban, gerente</span></div>
              <div><code class="text-yellow-400">lider</code> <span class="text-gray-400">&mdash; Corban, líder de equipe</span></div>
              <div><code class="text-yellow-400">vendedor</code> <span class="text-gray-400">&mdash; Corban, padrão</span></div>
            </div>
          </div>
        </section>

        <section id="fluxo-propostas">
          <h2 class="section-title">Fluxo: Propostas</h2>
          <p class="text-gray-400 mb-4">Propostas são importadas em lote via CSV. O processamento é assíncrono via Celery.</p>
          <div class="space-y-3">
            <div class="flow-step"><span class="step-badge">1</span><div>
              <p class="text-white font-medium">Configurar Layout do banco</p>
              <code class="text-blue-400 text-xs">POST /api/proposals/layouts/</code>
              <p class="text-gray-400 text-sm mt-0.5">Define o mapeamento das colunas do CSV para campos internos.</p>
            </div></div>
            <div class="flow-step"><span class="step-badge">2</span><div>
              <p class="text-white font-medium">Pré-visualizar CSV (opcional)</p>
              <code class="text-blue-400 text-xs">POST /api/proposals/preview-rows/</code>
            </div></div>
            <div class="flow-step"><span class="step-badge">3</span><div>
              <p class="text-white font-medium">Criar lote de propostas</p>
              <code class="text-blue-400 text-xs">POST /api/proposals/batch/</code>
              <p class="text-gray-400 text-sm mt-0.5">Envia CSV + layout. Retorna <code>task_id</code> para acompanhar o processamento.</p>
            </div></div>
            <div class="flow-step"><span class="step-badge">4</span><div>
              <p class="text-white font-medium">Acompanhar processamento</p>
              <code class="text-blue-400 text-xs">GET /api/proposals/batch/{"{uuid}"}/</code>
              <p class="text-gray-400 text-sm mt-0.5">Status: pending / processing / done / error</p>
            </div></div>
          </div>
        </section>

        <section id="fluxo-comissoes">
          <h2 class="section-title">Fluxo: Comissões &amp; Pagamentos</h2>
          <div class="space-y-3">
            <div class="flow-step"><span class="step-badge">1</span><div>
              <p class="text-white font-medium">Configurar Grupos de Comissão</p>
              <code class="text-blue-400 text-xs">POST /api/commission-groups/</code>
              <p class="text-gray-400 text-sm mt-0.5">Define taxas por banco/tabela/faixa para vendedores e líderes.</p>
            </div></div>
            <div class="flow-step"><span class="step-badge">2</span><div>
              <p class="text-white font-medium">Configurar tetos da Promotora</p>
