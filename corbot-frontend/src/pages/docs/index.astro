              <div class="payload-header">
                <span class="method-badge bg-green-900 text-green-300">POST</span>
                <code class="text-blue-400">/api/commission-groups/by-company/</code>
                <span class="payload-tag">Grupo da Promotora (tetos)</span>
              </div>
              <div class="payload-grid">
                <div>
                  <p class="payload-label">Request</p>
                  <pre class="code-block text-xs whitespace-pre">{"{\n  \"name\": \"Teto Promotora 2025\",\n  \"description\": \"Limite máximo de repasse\",\n  \"color\": \"#f59e0b\",\n  \"commission_rules\": [\n    {\n      \"bank\": \"uuid-do-banco\",\n      \"table\": \"uuid-da-tabela\",\n      \"commission_range\": \"0-50000\",\n      \"commission_rate\": \"2.50\"\n    }\n  ]\n}"}</pre>
                </div>
                <div>
                  <p class="payload-label">Response 201</p>
                  <pre class="code-block text-xs whitespace-pre">{"{\n  \"id\": 3,\n  \"name\": \"Teto Promotora 2025\",\n  \"color\": \"#f59e0b\",\n  \"is_active\": true,\n  \"commission_rules\": [...],\n  \"companies\": []\n}"}</pre>
                </div>
              </div>
            </div>
          </div>
        </section>

        <section id="payload-payments">
          <h2 class="section-title">Payloads — Pagamentos &amp; Saques</h2>
          <div class="space-y-6">
            <div class="payload-card">
              <div class="payload-header">
                <span class="method-badge bg-green-900 text-green-300">POST</span>
                <code class="text-blue-400">/api/payments/generate-comissions/</code>
                <span class="payload-tag">Gerar comissões</span>
              </div>
              <div class="payload-grid">
                <div>
                  <p class="payload-label">Request</p>
                  <pre class="code-block text-xs whitespace-pre">{"{\n  \"batch_id\": \"uuid-do-lote\",\n  \"competence\": \"2025-05\"\n}"}</pre>
                </div>
                <div>
                  <p class="payload-label">Response 200</p>
                  <pre class="code-block text-xs whitespace-pre">{"{\n  \"generated\": 448,\n  \"total_amount\": \"125430.00\",\n  \"competence\": \"2025-05\"\n}"}</pre>
                </div>
              </div>
            </div>
            <div class="payload-card">
              <div class="payload-header">
                <span class="method-badge bg-green-900 text-green-300">POST</span>
                <code class="text-blue-400">/api/withdrawals/corbanpay/</code>
                <span class="payload-tag">Solicitar saque via PIX</span>
              </div>
              <div class="payload-grid">
                <div>
                  <p class="payload-label">Request</p>
                  <pre class="code-block text-xs whitespace-pre">{"{\n  \"amount\": \"500.00\",\n  \"pix_key\": \"12345678901\",\n  \"pix_type\": \"cpf\",\n  \"description\": \"Saque comissões maio/2025\"\n}"}</pre>
                </div>
                <div>
                  <p class="payload-label">Response 201</p>
                  <pre class="code-block text-xs whitespace-pre">{"{\n  \"id\": \"uuid-do-saque\",\n  \"amount\": \"500.00\",\n  \"status\": \"pending\",\n  \"pix_key\": \"12345678901\",\n  \"pix_type\": \"cpf\",\n  \"created_at\": \"2025-05-06T10:00:00Z\"\n}"}</pre>
                </div>
              </div>
              <div class="mt-3 bg-gray-800 rounded-lg p-3 border border-gray-700 text-xs">
                <p class="text-gray-400 mb-1">Tipos de PIX (<code>pix_type</code>):</p>
                <div class="flex flex-wrap gap-3">
                  <code class="text-yellow-400">cpf</code>
                  <code class="text-yellow-400">cnpj</code>
                  <code class="text-yellow-400">email</code>
                  <code class="text-yellow-400">phone</code>
                  <code class="text-yellow-400">random</code>
                </div>
              </div>
            </div>
          </div>
        </section>

        <section id="payload-apikeys">
          <h2 class="section-title">Payloads — Chaves de API</h2>
          <div class="space-y-6">
            <div class="payload-card">
              <div class="payload-header">
                <span class="method-badge bg-green-900 text-green-300">POST</span>
                <code class="text-blue-400">/api/api-keys/</code>
                <span class="payload-tag">Criar chave</span>
              </div>
              <div class="payload-grid">
                <div>
                  <p class="payload-label">Request</p>
                  <pre class="code-block text-xs whitespace-pre">{"{\n  \"name\": \"Integração ERP\",\n  \"scopes\": [\n    \"users:read\",\n    \"proposals:read\",\n    \"commissions:read\"\n  ],\n  \"expires_at\": \"2026-12-31T23:59:59Z\"\n}"}</pre>
                </div>
                <div>
                  <p class="payload-label">Response 201 — chave exibida UMA VEZ</p>
                  <pre class="code-block text-xs whitespace-pre">{"{\n  \"id\": \"uuid-da-chave\",\n  \"name\": \"Integração ERP\",\n  \"prefix\": \"crb_abc123\",\n  \"full_key\": \"crb_abc123xyz...segredo\",\n  \"scopes\": [\"users:read\", \"proposals:read\",\n             \"commissions:read\"],\n  \"is_active\": true,\n  \"expires_at\": \"2026-12-31T23:59:59Z\",\n  \"created_at\": \"2025-05-06T10:00:00Z\"\n}"}</pre>
                </div>
              </div>
              <div class="mt-3 bg-red-900/30 border border-red-700 rounded-lg p-3 text-xs text-red-300">
                &#9888;&#65039; O campo <code>full_key</code> é retornado <strong>apenas nesta resposta</strong>. Guarde-o imediatamente.
              </div>
            </div>
            <div class="payload-card">
              <div class="payload-header">
                <span class="method-badge bg-orange-900 text-orange-300">PATCH</span>
                <code class="text-blue-400">/api/api-keys/{"{uuid}"}/</code>
                <span class="payload-tag">Atualizar chave</span>
              </div>
              <div class="payload-grid">
                <div>
                  <p class="payload-label">Request</p>
                  <pre class="code-block text-xs whitespace-pre">{"{\n  \"name\": \"Integração ERP v2\",\n  \"scopes\": [\n    \"users:read\",\n    \"commissions:read\",\n    \"commissions:write\"\n  ]\n}"}</pre>
                </div>
                <div>
                  <p class="payload-label">Response 200</p>
                  <pre class="code-block text-xs whitespace-pre">{"{\n  \"id\": \"uuid-da-chave\",\n  \"name\": \"Integração ERP v2\",\n  \"prefix\": \"crb_abc123\",\n  \"scopes\": [\"users:read\", \"commissions:read\",\n             \"commissions:write\"],\n  \"is_active\": true\n}"}</pre>
                </div>
              </div>
            </div>
            <div class="payload-card">
              <div class="payload-header">
                <span class="method-badge bg-green-900 text-green-300">POST</span>
                <code class="text-blue-400">/api/api-keys/{"{uuid}"}/revoke/</code>
                <span class="payload-tag">Revogar chave</span>
              </div>
              <div class="payload-grid">
                <div>
                  <p class="payload-label">Request (sem body)</p>
                  <pre class="code-block text-xs whitespace-pre">{"{}"}</pre>
                </div>
                <div>
                  <p class="payload-label">Response 200</p>
                  <pre class="code-block text-xs whitespace-pre">{"{\n  \"detail\": \"Chave revogada com sucesso.\",\n  \"id\": \"uuid-da-chave\",\n  \"is_active\": false\n}"}</pre>
                </div>
              </div>
            </div>
            <div class="payload-card">
              <div class="payload-header">
                <span class="method-badge bg-blue-900 text-blue-300">GET</span>
                <code class="text-blue-400">/api/api-keys/available-scopes/</code>
                <span class="payload-tag">Listar escopos disponíveis</span>
              </div>
              <div>
                <p class="payload-label">Response 200</p>
                <pre class="code-block text-xs whitespace-pre">{"[\n  { \"value\": \"users:read\",        \"label\": \"Usuários — Leitura\" },\n  { \"value\": \"users:write\",       \"label\": \"Usuários — Escrita\" },\n  { \"value\": \"companies:read\",    \"label\": \"Corbans — Leitura\" },\n  { \"value\": \"companies:write\",   \"label\": \"Corbans — Escrita\" },\n  { \"value\": \"proposals:read\",    \"label\": \"Propostas — Leitura\" },\n  { \"value\": \"proposals:write\",   \"label\": \"Propostas — Escrita\" },\n  { \"value\": \"commissions:read\",  \"label\": \"Comissões — Leitura\" },\n  { \"value\": \"commissions:write\", \"label\": \"Comissões — Escrita\" },\n  { \"value\": \"payments:read\",     \"label\": \"Pagamentos — Leitura\" },\n  { \"value\": \"payments:write\",    \"label\": \"Pagamentos — Escrita\" },\n  { \"value\": \"tables:read\",       \"label\": \"Tabelas — Leitura\" },\n  { \"value\": \"tables:write\",      \"label\": \"Tabelas — Escrita\" },\n  { \"value\": \"banks:read\",        \"label\": \"Bancos — Leitura\" },\n  { \"value\": \"bank_access:read\",  \"label\": \"Acessos — Leitura\" },\n  { \"value\": \"bank_access:write\", \"label\": \"Acessos — Escrita\" }\n]"}</pre>
              </div>
            </div>
          </div>
        </section>

        <footer class="border-t border-gray-800 pt-8 pb-4 text-center text-gray-600 text-xs">
          CorbanPlus API v1 &mdash; Documentação interna.
        </footer>

      </main>
    </div>
  </div>
</BaseLayout>

