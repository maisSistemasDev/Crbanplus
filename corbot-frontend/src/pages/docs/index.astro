            </div></div>
            <div class="flow-step"><span class="step-badge">3</span><div>
              <p class="text-white font-medium">Gerar comissões</p>
              <code class="text-blue-400 text-xs">POST /api/payments/generate-comissions/</code>
            </div></div>
