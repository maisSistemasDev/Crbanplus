              <div class="bg-gray-800 rounded-lg px-4 py-3 border border-gray-700">
                <p class="text-xs font-semibold text-gray-300 mb-1">{label}</p>
                <code class="text-green-400 text-xs">{scope}</code>
              </div>
            ))}
          </div>
        </section>

