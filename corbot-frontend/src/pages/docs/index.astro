              <th class="text-left py-2 pr-4 text-gray-400 font-medium">Contexto</th>
              <th class="text-left py-2 text-gray-400 font-medium">Descrição</th>
            </tr></thead>
            <tbody class="divide-y divide-gray-800">
              <tr><td class="py-2 pr-4"><code class="text-yellow-400">admin</code></td><td class="py-2 pr-4 text-gray-400">Promotora</td><td class="py-2 text-gray-300">Acesso total. Sem empresa vinculada.</td></tr>
              <tr><td class="py-2 pr-4"><code class="text-yellow-400">colaborador</code></td><td class="py-2 pr-4 text-gray-400">Promotora</td><td class="py-2 text-gray-300">Permissões granulares via UserPermission ou templates.</td></tr>
              <tr><td class="py-2 pr-4"><code class="text-yellow-400">empresa_admin</code></td><td class="py-2 pr-4 text-gray-400">Corban</td><td class="py-2 text-gray-300">Admin da empresa parceira.</td></tr>
              <tr><td class="py-2 pr-4"><code class="text-yellow-400">gerente</code></td><td class="py-2 pr-4 text-gray-400">Corban</td><td class="py-2 text-gray-300">Gerencia líderes e equipes.</td></tr>
              <tr><td class="py-2 pr-4"><code class="text-yellow-400">lider</code></td><td class="py-2 pr-4 text-gray-400">Corban</td><td class="py-2 text-gray-300">Lidera vendedores. Recebe comissão de liderança.</td></tr>
              <tr><td class="py-2 pr-4"><code class="text-yellow-400">vendedor</code></td><td class="py-2 pr-4 text-gray-400">Corban</td><td class="py-2 text-gray-300">Perfil padrão. Vinculado a líder e equipe.</td></tr>
            </tbody>
          </table>
