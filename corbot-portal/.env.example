# URL base do backend (sem o sufixo /api). O código adiciona /api e /ws.
#
# Dev local (portal em :3001, backend em :8000 são origens diferentes):
#   PUBLIC_API_URL=http://localhost:8000
#
# Produção atrás do Nginx Proxy Manager (mesma origem do subdomínio do portal,
# o NPM faz proxy de /api, /media, /static e /ws para o backend Django):
#   Deixe vazio (ou não defina). O cliente usa caminhos relativos:
#     - /api/...
#     - /media/..., /static/...
PUBLIC_API_URL=http://localhost:8000

# URL do frontend admin atual (corbot-frontend), usada para redirecionar de
# volta usuários admin/colaborador que caírem aqui por engano.
PUBLIC_ADMIN_APP_URL=http://localhost:3000
