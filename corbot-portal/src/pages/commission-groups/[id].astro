---
import PortalLayout from '../../layouts/PortalLayout.astro';
import { AppShell } from '../../components/react/layout/AppShell';
import { GroupDetail } from '../../components/react/domain/commission-groups/GroupDetail';

const { id } = Astro.params;
const groupId = Number(id);
---
<PortalLayout title="Equipe - Portal Corban">
  <AppShell client:only="react">
    <GroupDetail client:only="react" groupId={groupId} />
  </AppShell>
</PortalLayout>
