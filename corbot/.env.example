# ==============================================================================
# WHITELABEL - Configurações de Branding
# ==============================================================================
# Personalize o nome e a logo do sistema através dessas variáveis
#
# SYSTEM_NAME: Nome do sistema exibido em toda a interface
#   Exemplos: "CorbanPlus", "MeuCorban", "Sistema XYZ"
#   Padrão: CorbanPlus
#
# SYSTEM_LOGO_URL: Caminho ou URL da logo (PNG, JPG, SVG)
#   Opção 1 - Arquivo local (recomendado):
#     Coloque a logo em corbot-frontend/public/ e use caminho relativo
#     Exemplo: /logo.png (para arquivo public/logo.png)
#              /assets/logo.svg (para arquivo public/assets/logo.svg)
#   
#   Opção 2 - URL externa:
#     Exemplo: https://meudominio.com/logo.png
#   
#   Padrão: (vazio - exibe inicial do nome em círculo)
#
# Após alterar, reinicie os containers:
#   sudo docker compose restart web frontend
# ==============================================================================

SYSTEM_NAME=CorbanPlus
SYSTEM_LOGO_URL=
