# Copie para stack.env e preencha. No Portainer: Stacks → Add/Edit stack →
# "Add file" → nome: stack.env (mesmo nome usado em env_file no compose).
#
# POSTGRES_* inicia o cluster; DB_* deve ser o mesmo usuário/senha/base (Django).

POSTGRES_DB=corbot
POSTGRES_USER=corbot_user
POSTGRES_PASSWORD=troque-esta-senha

DB_NAME=corbot
DB_USER=corbot_user
DB_PASSWORD=troque-esta-senha

# PgBouncer: usuários que podem conectar ao banco admin do pgbouncer (mesmo que DB_USER costuma bastar)
ADMIN_USERS=corbot_user

# Django
SECRET_KEY=gere-uma-chave-longa-e-aleatoria
ALLOWED_HOSTS=seudominio.com.br,web,localhost
CSRF_TRUSTED_ORIGINS=https://seudominio.com.br
CORS_ALLOWED_ORIGINS=https://seudominio.com.br

# Opcional — pool (defaults do compose também servem)
# PGBOUNCER_MAX_CLIENT_CONN=200
# PGBOUNCER_DEFAULT_POOL_SIZE=25
# PGBOUNCER_MIN_POOL_SIZE=5
# PGBOUNCER_RESERVE_POOL_SIZE=5

TRANSFEERA_API_CLIENT_ID=
TRANSFEERA_API_CLIENT_SECRET=

SYSTEM_NAME=CorbanPlus
SYSTEM_LOGO_URL=/logo.jpeg
